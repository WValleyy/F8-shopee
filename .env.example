# Database
# Atlas connection string. Keep credentials out of source control.
MONGODB_URI=
# Local alternative:
# MONGODB_URI=mongodb://127.0.0.1:27017/f8-shopee?replicaSet=rs0
MONGODB_DB_NAME=f8-shopee

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional email (Gmail SMTP)
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=F8 Shopee

# Authentication
# Generate three independent secrets with at least 32 characters each.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
AUTH_GRACE_ENCRYPTION_KEY=


# Application
NODE_ENV=development
# Local HTTP port. Vercel does not use this value.
PORT=3000
APP_ORIGIN=http://localhost:3000
TRUST_PROXY=0
AUTH_RATE_LIMIT_ENABLED=true
