<%- include("./components/account-header", {
    title: "Hồ sơ của tôi",
    description: "Quản lý thông tin hồ sơ để bảo mật tài khoản"
}) %>

<section class="profile">

    <!-- ================= Profile Form ================= -->

    <form
        id="profile-form"
        class="profile-form">

        <!-- Username -->

        <div class="profile-form__group">

            <label class="profile-form__label">

                Tên đăng nhập

            </label>

            <div class="profile-form__field">

                <span class="profile-form__text">

                    <%= currentUser.userName %>

                </span>

            </div>

        </div>

        <!-- Name -->

        <div class="profile-form__group">

            <label
                for="profile-name"
                class="profile-form__label">

                Tên

            </label>

            <div class="profile-form__field">

                <input
                    id="profile-name"
                    name="name"
                    type="text"
                    class="profile-form__input"
                    value="<%= currentUser.name %>">

            </div>

        </div>

        <!-- Email -->

        <div class="profile-form__group">

            <label class="profile-form__label">

                Email

            </label>

            <div class="profile-form__field">

                <span class="profile-form__text">

                    <%= currentUser.email %>

                </span>

                <button
                    type="button"
                    class="profile-form__action"
                    data-change-email>

                    Thay đổi

                </button>

            </div>

        </div>

        <!-- Phone -->

        <div class="profile-form__group">

            <label class="profile-form__label">

                Số điện thoại

            </label>

            <div class="profile-form__field">

                <span class="profile-form__text">

                    <%= currentUser.phone || "Chưa cập nhật" %>

                </span>

                <button
                    type="button"
                    class="profile-form__action"
                    data-change-phone>

                    <%= currentUser.phone ? "Thay đổi" : "Thêm" %>

                </button>

            </div>

        </div>

        <!-- Gender -->

        <div class="profile-form__group">

            <label class="profile-form__label">

                Giới tính

            </label>

            <div class="profile-form__field">

                <label class="profile-form__radio">

                    <input
                        type="radio"
                        name="gender"
                        value="male"
                        <%= currentUser.gender === "male" ? "checked" : "" %>>

                    Nam

                </label>

                <label class="profile-form__radio">

                    <input
                        type="radio"
                        name="gender"
                        value="female"
                        <%= currentUser.gender === "female" ? "checked" : "" %>>

                    Nữ

                </label>

                <label class="profile-form__radio">

                    <input
                        type="radio"
                        name="gender"
                        value="other"
                        <%= currentUser.gender === "other" ? "checked" : "" %>>

                    Khác

                </label>

            </div>

        </div>

        <!-- Birthday -->

        <div class="profile-form__group">

            <label class="profile-form__label">

                Ngày sinh

            </label>

            <div class="profile-form__field">

                <select
                    id="birthday-day"
                    name="birthDay"
                    class="profile-form__select">

                    <option value="">Ngày</option>

                </select>

                <select
                    id="birthday-month"
                    name="birthMonth"
                    class="profile-form__select">

                    <option value="">Tháng</option>

                </select>

                <select
                    id="birthday-year"
                    name="birthYear"
                    class="profile-form__select">

                    <option value="">Năm</option>

                </select>

            </div>

        </div>

        <!-- Submit -->

        <div class="profile-form__group">

            <div class="profile-form__label"></div>

            <div class="profile-form__field">

                <button
                    type="submit"
                    class="btn btn--primary profile-form__submit">

                    Lưu

                </button>

            </div>

        </div>

    </form>

    <!-- ================= Avatar ================= -->

    <aside class="profile-avatar">

        <div class="profile-avatar__image">

            <% if (currentUser.avatar) { %>

                <img
                    src="<%= currentUser.avatar %>"
                    alt="<%= currentUser.name %>">

            <% } else { %>

                <svg
                    enable-background="new 0 0 15 15"
                    viewBox="0 0 15 15">

                    <g>

                        <circle
                            cx="7.5"
                            cy="4.5"
                            r="3.8"
                            fill="none"
                            stroke-miterlimit="10">
                        </circle>

                        <path
                            d="m1.5 14.2c0-3.3 2.7-6 6-6s6 2.7 6 6"
                            fill="none"
                            stroke-linecap="round"
                            stroke-miterlimit="10">
                        </path>

                    </g>

                </svg>

            <% } %>

        </div>

        <input
            id="avatar-input"
            type="file"
            accept="image/*"
            hidden>

        <button
            type="button"
            class="btn profile-avatar__button">

            Chọn ảnh

        </button>

        <p class="profile-avatar__note">

            Dung lượng tối đa 1 MB

        </p>

        <p class="profile-avatar__note">

            Định dạng: JPEG, PNG

        </p>

    </aside>

</section>

<!-- ================= Change Email Modal ================= -->

<div
    id="change-email-modal"
    class="modal">

    <div class="modal__overlay"></div>

    <div class="modal__body">

        <form
            id="change-email-form"
            class="auth-form">

            <div class="auth-form__container">

                <div class="auth-form__header">

                    <h3 class="auth-form__heading">

                        Thay đổi Email

                    </h3>

                </div>

                <div class="auth-form__form">

                    <div class="auth-form__group">

                        <input
                            type="email"
                            name="email"
                            class="auth-form__input"
                            placeholder="Nhập email mới">

                    </div>

                </div>

                <div class="auth-form__controls">

                    <button
                        type="button"
                        class="btn auth-form__controls-back">

                        Hủy

                    </button>

                    <button
                        type="submit"
                        class="btn btn--primary">

                        Xác nhận

                    </button>

                </div>

            </div>

        </form>

    </div>

</div>

<!-- ================= Change Phone Modal ================= -->

<div
    id="change-phone-modal"
    class="modal">

    <div class="modal__overlay"></div>

    <div class="modal__body">

        <form
            id="change-phone-form"
            class="auth-form">

            <div class="auth-form__container">

                <div class="auth-form__header">

                    <h3 class="auth-form__heading">

                        Thay đổi số điện thoại

                    </h3>

                </div>

                <div class="auth-form__form">

                    <div class="auth-form__group">

                        <input
                            type="tel"
                            name="phone"
                            class="auth-form__input"
                            placeholder="Nhập số điện thoại mới">

                    </div>

                </div>

                <div class="auth-form__controls">

                    <button
                        type="button"
                        class="btn auth-form__controls-back">

                        Hủy

                    </button>

                    <button
                        type="submit"
                        class="btn btn--primary">

                        Xác nhận

                    </button>

                </div>

            </div>

        </form>

    </div>

</div>