<!-- ================= Account Header ================= -->

<header class="account-header">

    <div class="account-header__content">

        <div class="account-header__info">

            <h1 class="account-header__title">

                <%= title %>

            </h1>

            <% if (description) { %>

                <p class="account-header__description">

                    <%= description %>

                </p>

            <% } %>

        </div>

        <% if (button) { %>

            <button
                type="button"
                id="<%= button.id || '' %>"
                class="btn btn--primary account-header__button">

                <%= button.text %>

            </button>

        <% } %>

    </div>

</header>