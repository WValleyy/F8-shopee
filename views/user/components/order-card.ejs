<%
const statusMap = {
    shipping: {
        shippingText: "Đơn hàng đang trên đường vận chuyển đến bạn",
        statusText: "ĐANG GIAO HÀNG",
        primaryButtonText: "Đã Nhận Được Hàng",
        buttonText: "Hủy Đơn Hàng"
    },

    delivered: {
        shippingText: "Đơn hàng đã được giao thành công",
        statusText: "HOÀN THÀNH",
        primaryButtonText: "Đánh Giá",
        buttonText: "Yêu Cầu Trả Hàng/Hoàn Tiền"
    },

    deliveredReviewed: {
        shippingText: "Đơn hàng đã được giao thành công",
        statusText: "HOÀN THÀNH",
        primaryButtonText: "Mua Lại",
    },

    cancelled: {
        shippingText: "Đơn hàng đã bị hủy",
        statusText: "ĐÃ HỦY",
        primaryButtonText: "Mua Lại"
    },

    returning: {
        shippingText: "Yêu cầu trả hàng/hoàn tiền của bạn đã được xử lý",
        statusText: "ĐÃ TRẢ HÀNG/HOÀN TIỀN"
    }
};

const statusInfo = statusMap[status];
%>

<article class="order-card">

    <!-- Header -->

    <header class="order-card__header">

        <div class="purchase-category">

            <div class="purchase-category__left">

                <a
                    href="#"
                    class="purchase-category__name">

                    <svg width="17" height="16" viewBox="0 0 17 16">
                        <title>Category Icon</title>
                        <path d="M1.95 6.6c.156.804.7 1.867 1.357 1.867.654 0 1.43 0 1.43-.933h.932s0 .933 1.155.933c1.176 0 1.15-.933 1.15-.933h.984s-.027.933 1.148.933c1.157 0 1.15-.933 1.15-.933h.94s0 .933 1.43.933c1.368 0 1.356-1.867 1.356-1.867H1.95zm11.49-4.666H3.493L2.248 5.667h12.437L13.44 1.934zM2.853 14.066h11.22l-.01-4.782c-.148.02-.295.042-.465.042-.7 0-1.436-.324-1.866-.86-.376.53-.88.86-1.622.86-.667 0-1.255-.417-1.64-.86-.39.443-.976.86-1.643.86-.74 0-1.246-.33-1.623-.86-.43.536-1.195.86-1.895.86-.152 0-.297-.02-.436-.05l-.018 4.79zM14.996 12.2v.933L14.984 15H1.94l-.002-1.867V8.84C1.355 8.306 1.003 7.456 1 6.6L2.87 1h11.193l1.866 5.6c0 .943-.225 1.876-.934 2.39v3.21z" 
                        stroke-width=".3" stroke="#333" fill="#333" fill-rule="evenodd">
                        </path>
                    </svg>

                    Bra House

                </a>

            </div>

            <div class="purchase-category__right">

                <span
                    class="purchase-category__shipping">

                    <%= statusInfo.shippingText %>

                </span>

                <span
                    class="purchase-category__status">

                    <%= statusInfo.statusText %>

                </span>

            </div>

        </div>

    </header>

    <!-- Body -->

    <div class="order-card__body">

        <!-- Product -->

        <div class="purchase-product">

            <a
                href="#"
                class="purchase-product__image">

                <img
                    src="./img/product-1.jpg"
                    alt=""
                    class="purchase-product__img">

            </a>

            <div
                class="purchase-product__content">

                <a
                    href="#"
                    class="purchase-product__name">

                    1 Gói Snack Khoai Tây PoTaTo
                    [Hàng Date Mới]

                </a>

                <p
                    class="purchase-product__variation">

                    Phân loại hàng:
                    Vị Mực

                </p>

                <span
                    class="purchase-product__quantity">

                    x3

                </span>

            </div>

            <div
                class="purchase-product__price">

                <span
                    class="purchase-product__old-price">

                    ₫18.000

                </span>

                <span
                    class="purchase-product__current-price">

                    ₫12.000

                </span>

            </div>

        </div>

    </div>

    <!-- Footer -->

    <footer class="order-card__footer">

        <div
            class="order-card__summary">

            <span>

                Thành tiền:

            </span>

            <strong>

                ₫36.000

            </strong>

        </div>

        <div
            class="order-card__actions">

            <% if (statusInfo.primaryButtonText) { %>
                <button class="btn btn--primary">
                    <%= statusInfo.primaryButtonText %>
                </button>
            <% } %>

            <% if (statusInfo.buttonText) { %>
                <button class="btn">
                    <%= statusInfo.buttonText %>
                </button>
            <% } %>

        </div>

    </footer>

</article>
