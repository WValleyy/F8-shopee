<!-- ================= Sidebar ================= -->

<aside class="user-sidebar">

    <!-- User -->

    <div class="user-sidebar__user">

        <div class="user-sidebar__avatar-wrapper">

            <svg
                enable-background="new 0 0 15 15"
                viewBox="0 0 15 15"
                x="0"
                y="0"
                class="icon-headshot">

                <g>

                    <circle
                        cx="7.5"
                        cy="4.5"
                        r="3.8"
                        fill="none"
                        stroke-miterlimit="10">
                    </circle>

                    <path
                        d="m1.5 14.2c0-3.3 2.7-6 6-6s6 2.7 6 6"
                        fill="none"
                        stroke-linecap="round"
                        stroke-miterlimit="10">
                    </path>

                </g>

            </svg>

        </div>

        <!--
        <a href="#" class="user-sidebar__avatar-link">

            <img
                src="https://media.tenor.com/S8Vv6-uLUA0AAAAM/cute-cat.gif"
                alt="Avatar"
                class="user-sidebar__avatar">

        </a>
        -->

        <div class="user-sidebar__user-info">

            <p class="user-sidebar__username">

                Valley

            </p>

            <a
                href="/account/profile"
                data-account-link
                data-page="profile"
                class="user-sidebar__edit">

                <svg
                    width="12"
                    height="12"
                    viewBox="0 0 12 12"
                    xmlns="http://www.w3.org/2000/svg"
                    style="margin-right: 4px;">

                    <path
                        d="M8.54 0L6.987 1.56l3.46 3.48L12 3.48M0 8.52l.073 3.428L3.46 12l6.21-6.18-3.46-3.48"
                        fill="#9B9B9B"
                        fill-rule="evenodd">
                    </path>

                </svg>

                <span>Sửa Hồ sơ</span>

            </a>

        </div>

    </div>

    <!-- Navigation -->

    <nav class="user-sidebar__nav">

        <!-- Account -->

        <div class="user-sidebar__group">

            <a
                href="/account/profile"
                data-account-link
                data-page="profile"
                class="user-sidebar__group-title">

                <img
                    src="https://down-vn.img.susercontent.com/file/ba61750a46794d8847c3f463c5e71cc4"
                    alt="Icon"
                    class="user-sidebar__icon">

                <span>

                    Tài khoản của tôi

                </span>

            </a>

            <ul class="user-sidebar__submenu">

                <li>

                    <a
                        href="/account/profile"
                        data-account-link
