                src="https://down-vn.img.susercontent.com/file/e10a43b53ec8605f4829da5618e0717c"
                class="user-sidebar__icon"
                alt="Notification">

            <span>

                Thông báo

            </span>

        </a>

        <!-- Voucher -->

        <a
            href="/account/voucher"
            data-account-link
            data-page="voucher"
            class="user-sidebar__item">

            <img
                src="https://down-vn.img.susercontent.com/file/84feaa363ce325071c0a66d3c9a88748"
                class="user-sidebar__icon"
                alt="Voucher">

