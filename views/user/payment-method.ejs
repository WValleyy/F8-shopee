<%- include("./components/account-header", {
    title: "Thẻ thanh toán",
    button: {
        id: "btn-add-payment-method",
        text: "+ Thêm thẻ mới"
    }
}) %>

<% if (paymentMethods.length) { %>

    <div class="payment-method">

        <div class="payment-method__list">

            <% paymentMethods.forEach(paymentMethod => { %>

                <%- include("../partials/payment-card", {
                    card: paymentMethod
                }) %>

            <% }) %>

        </div>

    </div>

<% } else { %>

    <section class="payment-method payment-method--empty">

        <div class="payment-method__empty">

            <svg
                class="payment-method__empty-icon"
                viewBox="0 0 24 24"
                aria-hidden="true">

                <path
                    d="M21 7H3a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h18a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2zm0 10H3V9h18zm-7-2h5v-2h-5zm-9 0h7v-2H5z">
                </path>

            </svg>

            <p class="payment-method__empty-text">

                Bạn chưa có thẻ thanh toán nào.

            </p>

            <button
                type="button"
                id="btn-add-payment-method-empty"
                class="btn btn--primary">

                Thêm thẻ mới

            </button>

        </div>

    </section>

<% } %>

<!-- ================= Add Payment Method Modal ================= -->

<div
    id="payment-method-modal"
    class="modal">

    <div class="modal__overlay"></div>

    <div class="modal__body">

        <form
            id="payment-method-form"
            class="auth-form">

            <div class="auth-form__container">

                <div class="auth-form__header">

                    <h3 class="auth-form__heading">

                        Thêm thẻ thanh toán

                    </h3>

                </div>

                <div class="auth-form__form">

                    <div class="auth-form__group">

                        <input
                            type="text"
                            class="auth-form__input"
                            placeholder="Tên chủ thẻ">

                    </div>

                    <div class="auth-form__group">

                        <div
                            id="card-element"
                            class="payment-method__card-element">

                        </div>

                    </div>

                </div>

                <div class="auth-form__controls">

                    <button
                        type="button"
                        class="btn auth-form__controls-back">

                        Hủy

                    </button>

                    <button
                        type="submit"
                        class="btn btn--primary">

                        Lưu

                    </button>

                </div>

            </div>

        </form>

    </div>

</div>