<%- include("./components/account-header", {
    title: "Kho Voucher"
}) %>

<% if (vouchers.length) { %>

    <section class="voucher">

        <div class="voucher__list">

            <% vouchers.forEach(voucher => { %>

                <%- include("../partials/voucher-card", {
                    voucher
                }) %>

            <% }) %>

        </div>

    </section>

<% } else { %>

    <section class="voucher voucher--empty">

        <div class="voucher__empty">

            <svg
                class="voucher__empty-icon"
                viewBox="0 0 24 24"
                aria-hidden="true">

                <path
                    d="M20 6H4a2 2 0 0 0-2 2v3h20V8a2 2 0 0 0-2-2zm2 7H2v3a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2zm-7-3a1 1 0 1 1 0-2 1 1 0 0 1 0 2zm0 6a1 1 0 1 1 0-2 1 1 0 0 1 0 2z">
                </path>

            </svg>

            <p class="voucher__empty-text">

                Bạn chưa có voucher nào.

            </p>

        </div>

    </section>

<% } %>