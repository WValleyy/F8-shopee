<template id="shared-pagination-link-item-template">
    <li class="pagination-item">
        <a class="pagination-item__link"></a>
    </li>
</template>

<template id="shared-pagination-link-icon-template">
    <li class="pagination-item">
        <a class="pagination-item__link">
            <i class="pagination-item__icon fa-solid"></i>
        </a>
    </li>
</template>

<template id="shared-pagination-link-ellipsis-template">
    <li class="pagination-item" data-disabled="true">
        <span class="pagination-item__link">...</span>
    </li>
</template>

<template id="shared-pagination-link-list-template">
    <ul class="pagination"></ul>
</template>
