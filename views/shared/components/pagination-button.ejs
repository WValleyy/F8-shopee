<template id="shared-pagination-button-item-template">
    <li class="pagination-item">
        <button
            type="button"
            class="pagination-item__link">
        </button>
    </li>
</template>

<template id="shared-pagination-button-icon-template">
    <li class="pagination-item">
        <button
            type="button"
            class="pagination-item__link">
            <i class="pagination-item__icon fa-solid"></i>
        </button>
    </li>
</template>

<template id="shared-pagination-button-ellipsis-template">
    <li class="pagination-item" data-disabled="true">
        <span class="pagination-item__link">...</span>
    </li>
</template>

<template id="shared-pagination-button-list-template">
    <ul class="pagination"></ul>
</template>
