<div
    class="modal modal--image-lightbox"
    data-modal
    data-image-lightbox
    hidden>
    <div class="modal__overlay" data-modal-close></div>

    <div
        class="modal__body image-lightbox"
        data-modal-content>
        <button
            type="button"
            class="image-lightbox__close"
            data-modal-close>
            <i class="fa-solid fa-xmark"></i>
        </button>
        <img alt="" data-image-lightbox-image>
    </div>
</div>
