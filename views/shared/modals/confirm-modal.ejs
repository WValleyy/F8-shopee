<div class="modal" data-modal data-confirm-modal hidden>
    <div class="modal__overlay" data-modal-close></div>

    <div class="modal__body" data-modal-content>
        <div class="modal-dialog confirm-modal">
            <header class="confirm-modal__header">
            <h3 data-confirm-title>
                Xác nhận thao tác
            </h3>
            <button
                class="confirm-modal__close"
                type="button"
                data-modal-close>
                <i class="fa-solid fa-xmark"></i>
            </button>
            </header>

            <p
                class="confirm-modal__message"
                data-confirm-message></p>

            <footer class="confirm-modal__footer">
            <button
                class="btn btn--size-l confirm-modal__button"
                type="button"
                data-modal-close>
                Hủy
            </button>
            <button
                class="btn btn--primary btn--size-l confirm-modal__button"
                type="button"
                data-confirm-submit>
                Xác nhận
            </button>
            </footer>
        </div>
    </div>
</div>
