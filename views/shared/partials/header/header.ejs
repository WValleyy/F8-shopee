<header class = "header">
    <div class="grid">
        <%- include("./navbar") %>

        <div class="header-with-search">
            <div class="header__logo">
                <a href="/" class="header__logo-link">
                    <%- include("./shopee-logo", { color: "#fff" }) %>
                </a>
            </div>

            <%- include("./search") %>

            <div class="header__cart">
                <div class="header__cart-wrapper" data-header-cart-preview>
                    <a href="/cart" class="header__cart-link">
                        <i class="header__cart-icon fa-solid fa-cart-shopping"></i>
                        <span
                            class="header__cart-notice"
                            data-cart-preview-notice
                            hidden></span>
                    </a>
                    <div
                        class="header__cart-list"
                        data-cart-preview-list
                        data-empty="false"
                        hidden>
                        <div data-cart-preview-empty hidden>
                            <img
                                src="/img/header-footer/no_cart.png"
                                alt="Chưa có sản phẩm trong giỏ hàng"
                                class="header__cart-no-cart-img">
                            <p class="header__cart-no-cart-msg">Giỏ hàng của bạn đang trống.</p>
                        </div>
                        <div data-cart-preview-populated hidden>
                            <h4 class="header__cart-heading">Sản phẩm mới thêm</h4>
                            <ul class="header__cart-list-items" data-header-cart-items></ul>
                            <a href="/cart" class="btn btn--primary header__cart-view-cart">Xem giỏ hàng</a>
                        </div>
                        <template data-cart-preview-item-template>
                            <li class="header__cart-item" data-cart-preview-item>
                                <img class="header__cart-item-img" data-cart-preview-image alt="">
                                <div class="header__cart-item-info">
                                    <div class="header__cart-item-head">
                                        <p class="header__cart-item-name" data-cart-preview-name></p>
                                        <div class="header__cart-item-price-wrapper">
                                            <span class="header__cart-item-price" data-cart-preview-price></span>
                                            <span class="header__cart-item-multiply">x</span>
                                            <span class="header__cart-item-quantity" data-cart-preview-quantity></span>
                                        </div>
                                    </div>
                                    <div class="header__cart-item-body">
                                        <span class="header__cart-item-description" data-cart-preview-classify></span>
                                    </div>
                                </div>
                            </li>
                        </template>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script type="application/json" data-header-state><%- serializeJsonForHtml({ cartPreview, notificationPreview }) %></script>
</header>
