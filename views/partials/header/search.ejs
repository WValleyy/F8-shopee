<div class="header__search-section">
    <div class="shopee-searchbar-wrapper">
        <form role="search" autocomplete="off" class="shopee-searchbar">
            <div class="shopee-searchbar__main">
                <div class="shopee-searchbar-input">
                    <input
                        type="text"
                        class="shopee-searchbar-input__input"
                        placeholder="Shopee bao ship 0Đ - Đăng ký ngay!"
                        maxlength="128"
                        autocomplete="off"
                        role="combobox"
                        aria-expanded="false"
                        aria-label="Shopee bao ship 0Đ - Đăng ký ngay!"
                    >
                </div>
            </div>
            <button class="shopee-searchbar__submit btn btn--primary btn--size-s" type="submit">
                <i class="shopee-searchbar__submit-icon fa-solid fa-magnifying-glass"></i>
            </button>
        </form>
        <div class="searchbar-history">
            <h3 class="searchbar-history__heading">
                Lịch sử tìm kiếm
            </h3>
            <ul class="searchbar-history__list">
            </ul>
        </div>
    </div>


</div>