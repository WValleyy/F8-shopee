<!-- ================= Voucher Card ================= -->

<article class="voucher-card">

    <div class="voucher-card__left">

        <div class="voucher-card__logo">

            <span class="voucher-card__logo-text">

                SHOPEE

            </span>

        </div>

    </div>

    <div class="voucher-card__content">

        <h3 class="voucher-card__title">

            <%= voucher.title %>

        </h3>

        <% if (voucher.description) { %>

            <p class="voucher-card__description">

                <%= voucher.description %>

            </p>

        <% } %>

        <p class="voucher-card__expire">

            HSD:
            <%= voucher.expiredAt %>

        </p>

    </div>

    <div class="voucher-card__right">

        <% if (voucher.isExpired) { %>

            <span class="voucher-card__status">

                Hết hạn

            </span>

        <% } else { %>

            <button
                type="button"
                class="voucher-card__button"
                data-use-voucher
                data-voucher-id="<%= voucher._id %>">

                Dùng ngay

            </button>

        <% } %>

    </div>

</article>