<%- include("../shared/user-header", {
    title: "Đổi mật khẩu",
    description: "Để bảo mật tài khoản, vui lòng không chia sẻ mật khẩu cho người khác."
}) %>

<section class="password">

    <form
        id="password-form"
        class="password-form">

        <!-- Current Password -->

        <div class="password-form__group">

            <label
                for="current-password"
                class="password-form__label">

                Mật khẩu hiện tại

            </label>

            <div class="password-form__field form-field form-field--stacked" data-form-field>

                <input
                    id="current-password"
                    name="currentPassword"
                    type="password"
                    class="form-control password-form__input"
                    placeholder="Nhập mật khẩu hiện tại"
                    autocomplete="current-password">

            </div>

        </div>

        <!-- New Password -->

        <div class="password-form__group">

            <label
                for="new-password"
                class="password-form__label">

                Mật khẩu mới

            </label>

            <div class="password-form__field form-field form-field--stacked" data-form-field>

                <input
                    id="new-password"
                    name="newPassword"
                    type="password"
                    class="form-control password-form__input"
                    placeholder="Nhập mật khẩu mới"
                    autocomplete="new-password">

            </div>

        </div>

        <!-- Confirm Password -->

        <div class="password-form__group">

            <label
                for="confirm-password"
                class="password-form__label">

                Xác nhận mật khẩu

            </label>

            <div class="password-form__field form-field form-field--stacked" data-form-field>

                <input
                    id="confirm-password"
                    name="confirmPassword"
                    type="password"
                    class="form-control password-form__input"
                    placeholder="Nhập lại mật khẩu mới"
                    autocomplete="new-password">

            </div>

        </div>

        <!-- Submit -->

        <div class="password-form__group">

            <div class="password-form__label"></div>

            <div class="password-form__field form-field form-field--stacked" data-form-field>

                <button
                    type="submit"
                    class="btn btn--primary password-form__submit">

                    Lưu

                </button>

            </div>

        </div>

    </form>

</section>
