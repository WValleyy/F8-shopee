<main class="error-page">
    <section class="error-page__content">
        <p class="error-page__code"><%= statusCode %></p>
        <h1 class="error-page__title">
            <%= errorTitle %>
        </h1>
        <p class="error-page__description">
            <%= description %>
        </p>
        <a href="<%= typeof actionHref !== 'undefined' ? actionHref : '/' %>" class="btn btn--primary error-page__action">
            <%= typeof actionLabel !== 'undefined' ? actionLabel : 'Về trang chủ' %>
        </a>
    </section>
</main>
