<%
const addresses = checkout?.addresses || [];
const activeAddress = checkout?.address || null;
const hasAddress = Boolean(activeAddress);
const totalAmount = Number(checkout.totalAmount || 0);

%>

<main class="checkout-page" data-checkout-page>
    <div class="grid">
        <form class="checkout-form" data-checkout-form data-checkout-management>
            <input type="hidden" name="draftId" value="<%= draftId %>">
            <input
                type="hidden"
                name="selectedAddressId"
                value="<%= activeAddress?.id || '' %>">

            <section class="checkout-address">
                <div class="checkout-address__title">
                    <svg
                        width="12"
                        height="16"
                        viewBox="0 0 12 16">
                        <path
                            d="M6 3.2c1.506 0 2.727 1.195 2.727 2.667 0 1.473-1.22 2.666-2.727 2.666S3.273 7.34 3.273 5.867C3.273 4.395 4.493 3.2 6 3.2zM0 6c0-3.315 2.686-6 6-6s6 2.685 6 6c0 2.498-1.964 5.742-6 9.933C1.613 11.743 0 8.498 0 6z"
                            fill-rule="evenodd"
                            fill="currentColor">
                        </path>
                    </svg>
                    Địa chỉ nhận hàng
                </div>

                <div class="checkout-address__content" data-checkout-address-summary>
                    <strong data-checkout-address-name <%= hasAddress ? '' : 'hidden' %>>
                        <%= hasAddress ? `${activeAddress.fullName} ${activeAddress.phone}` : '' %>
                    </strong>
                    <span data-checkout-address-full <%= hasAddress ? '' : 'hidden' %>>
                        <%= hasAddress
                            ? [
                                activeAddress.addressLine,
                                activeAddress.ward,
                                activeAddress.province,
                            ].filter(Boolean).join(', ')
                            : '' %>
                    </span>
                    <span
                        class="checkout-address__badge"
                        data-checkout-address-default
                        <%= activeAddress?.isDefault ? '' : 'hidden' %>>
                        Mặc định
                    </span>
                    <p
                        class="checkout-manage__empty-text"
                        data-checkout-address-empty
                        <%= hasAddress ? 'hidden' : '' %>>
                        Bạn chưa có địa chỉ cho đơn hàng này.
                    </p>
                    <button
                        type="button"
                        class="checkout-address__change"
                        data-open-address-selector>
                        <%= hasAddress ? 'Thay đổi' : 'Chọn địa chỉ' %>
                    </button>
                </div>
            </section>

            <section class="checkout-products">
                <div class="checkout-header">
                    <div>Sản phẩm</div>
                    <div>Đơn giá</div>
                    <div>Số lượng</div>
                    <div>Thành tiền</div>
                </div>

                <div>
                    <% checkout.items.forEach(item => {
                        const optionValues = item.options.map(option => option.value);
                        const optionText = optionValues.length
                            ? optionValues.join(', ')
                            : 'Mặc định';
                    %>
                        <div class="checkout-item">
                            <div class="checkout-product">
                                <img src="<%= item.image || '/img/header-footer/app_gallery.png' %>" alt="<%= item.productName %>">

                                <div class="checkout-product__info">
                                    <h3 class="checkout-product__name"><%= item.productName %></h3>
                                    <p class="checkout-product__classify">Phân loại: <%= optionText %></p>
                                </div>
                            </div>

                            <div class="checkout-price"><%= formatCurrency(item.price) %></div>
                            <div class="checkout-quantity"><%= item.quantity %></div>
                            <div class="checkout-total"><%= formatCurrency(item.total) %></div>
                        </div>
                    <% }) %>
                </div>
            </section>

            <section class="checkout-note">
                <div class="checkout-note__message">
                    <label>Lời nhắn</label>
                    <input
                        type="text"
                        name="note"
                        class="form-control"
                        maxlength="<%= inputLimits.order.noteMaxLength %>"
                        placeholder="Lưu ý cho người bán...">
                </div>

            </section>

            <section class="checkout-payment">
                <h3>Phương thức thanh toán</h3>
                <div class="checkout-payment__list">
                    <span class="checkout-payment__item" aria-pressed="true">
                        Thanh toán khi nhận hàng
                    </span>
                </div>
            </section>

            <section class="checkout-summary">
                <div class="checkout-summary__total">
                    <div class="checkout-summary__row">
                        <span>Tổng cộng</span>
                        <strong><%= formatCurrency(totalAmount) %></strong>
                    </div>
                </div>

                <div class="checkout-summary__actions">
                    <p
                        class="checkout-summary__warning"
                        data-checkout-address-warning
                        <%= hasAddress ? 'hidden' : '' %>>
                        Chọn một địa chỉ cho đơn hàng để đặt hàng.
                    </p>
                    <button class="btn btn--primary" type="submit" data-checkout-submit <%= hasAddress && checkout.items.length ? '' : 'disabled' %>>
                        Đặt hàng
                    </button>
                </div>
            </section>
        </form>
    </div>
<div
    id="checkout-address-selector-modal"
    class="modal"
    data-modal
    hidden>

    <div class="modal__overlay" data-modal-close></div>

    <div
        class="modal__body"
        data-modal-content>
        <div class="modal-dialog">
            <div class="modal-dialog__container checkout-selector">
                <div class="modal-dialog__header checkout-selector__header">
                    <h3 class="modal-dialog__title">Địa chỉ của tôi</h3>

                    <button
                        type="button"
                        class="checkout-selector__close"
                        data-modal-close>
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <div class="checkout-selector__body" data-checkout-address-list>
                    <%- include("./address-list", {
                        addresses,
                        selectedAddressId: activeAddress?.id || '',
                    }) %>
                </div>

                <div class="modal-dialog__actions checkout-selector__controls">
                    <button
                        type="button"
                        class="btn btn--primary"
                        data-open-address-form>
                        + Thêm địa chỉ mới
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>


<%- include("../../../shared/modals/address-form-modal") %>

</main>
