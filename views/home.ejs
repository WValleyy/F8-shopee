<!DOCTYPE html>
<html lang="en">
<%- include("partials/head", {
    title: "Shopee Việt Nam | Mua sắm Online"
}) %>
<body>
    <div class = "app">
        <%- include("partials/header/header") %>

        <main class="app__container">
            <div class="grid">
                <div class="grid__row app__content">
                    <div class="grid__column-2">
                        <nav class="category">
                            <h3 class="category__heading">
                                <i class="category__heading-icon fa-solid fa-list"></i>
                                Danh mục</h3>
                            <ul class="category-list">
                                <li class="category-item category-item--active">
                                    <a href="" class="category-item__link" data-category="all">Tất cả</a>
                                </li>
                                <li class="category-item">
                                    <a href="" class="category-item__link" data-category="phone">Điện thoại & Phụ kiện</a>
                                </li>
                                <li class="category-item">
                                    <a href="" class="category-item__link" data-category="laptop">Máy tính & Laptop</a>
                                </li>
                                <li class="category-item">
                                    <a href="" class="category-item__link" data-category="electronics">Thiết bị điện tử</a>
                                </li>
                                <li class="category-item">
                                    <a href="" class="category-item__link" data-category="watch">Đồng hồ</a>
                                </li>
                                <li class="category-item">
                                    <a href="" class="category-item__link" data-category="fashion-men">Thời trang nam</a>
                                </li>
                                <li class="category-item">
                                    <a href="" class="category-item__link" data-category="fashion-women">Thời trang nữ</a>
                                </li>
                                <li class="category-item">
                                    <a href="" class="category-item__link" data-category="fashion-kids">Thời trang trẻ em</a>
                                </li>
                                <li class="category-item">
                                    <a href="" class="category-item__link" data-category="men-shoes">Giày dép nam</a>
                                </li>
                                <li class="category-item">
                                    <a href="" class="category-item__link" data-category="women-shoes">Giày dép nữ</a>
                                </li>
                        </nav>
                    </div>
                    <div class="grid__column-10">
                        <div class="home-filter">
                           <div class="home-filter__right-wrapper">
                                 <span class="home-filter__label">Sắp xếp theo</span>
                                <button class="home-filter__btn btn btn--primary" data-sort="popular">Phổ biến</button>
                                <button class="home-filter__btn btn" data-sort="newest">Mới nhất</button>
                                <button class="home-filter__btn btn" data-sort="best-selling">Bán chạy</button>

                                <div class="select-filter">
                                    <span class="select-filter__label">Giá</span>
                                    <i class="select-filter__icon fa-solid fa-chevron-down"></i>

                                    <ul class="select-filter__list">
                                        <li class="select-filter__item">
                                            <a href="" class="select-filter__item-link" data-sort="price-asc">
                                                Giá: Thấp đến cao
                                            </a>
                                        </li>
                                        <li class="select-filter__item">
                                            <a href="" class="select-filter__item-link" data-sort="price-desc">
                                                Giá: Cao đến thấp
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                           </div>

                            <div class="home-filter__page">
                                <span class="home-filter__page-num">
                                   <span class="home-filter__page-current">1</span>/<span class="home-filter__page-total">14</span>
                                </span>

                                <div class="home-filter__page-control">
                                    <a href="" class="home-filter__page-btn btn btn--no-hover btn--disable" data-navigation="prev">
                                        <i class="home-filter__page-icon fa-solid fa-chevron-left"></i>
                                    </a>
                                    <a href="" class="home-filter__page-btn btn btn--no-hover" data-navigation="next">
                                        <i class="home-filter__page-icon fa-solid fa-chevron-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="home-product">
                            <div class="grid__row">

                            <%- include("partials/product/product-card") %>
            
                                
                            </div>
                        </div>

                        <%- include("partials/shared/pagination") %>

                    </div>

                </div>
            </div>
        </main>
        
    </div>
    
    <%- include("partials/footer") %>

    <%- include("partials/auth-modal") %>

    </div>
    <script src="js/app.js"></script>
    <script src="js/products.js"></script>
    <script src="js/auth.js"></script>
    <script src="js/home.js"></script>
</body>

</html>